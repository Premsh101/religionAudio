generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ContentType { SCRIPTURE TRANSLATION COMMENTARY STORY MYTHOLOGY FOLKLORE GHOST_STORY MORAL_TALE BIOGRAPHY FESTIVAL RITUAL HISTORICAL_ACCOUNT SACRED_PLACE }
enum Audience { KIDS FAMILY TEENS ADULTS RESEARCH }
enum EvidenceLens { TEXT TRADITION SCHOLARSHIP SCIENCE }
enum RightsStatus { UNKNOWN RESEARCH_ONLY PERMISSION_REQUIRED COMMERCIAL_CLEARED }
enum NarrationProfile { DEFAULT SCRIPTURE MYTHOLOGY FOLKLORE GHOST KIDS MORAL_TALE }
enum StoryIntensity { GENTLE ADVENTUROUS SPOOKY DARK }
enum UserRole { USER EDITOR ADMIN }
enum StoryStatus { DRAFT REVIEW PUBLISHED ARCHIVED }
enum AudioJobStatus { QUEUED PROCESSING COMPLETED FAILED }

model User {
  id String @id @default(cuid())
  displayName String?
  email String? @unique
  phone String? @unique
  passwordHash String
  role UserRole @default(USER)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workProgress WorkProgress[]
  storyProgress StoryProgress[]
  bookmarks Bookmark[]
}
model Religion { id String @id @default(cuid()); name String @unique; slug String @unique; traditions Tradition[]; works Work[]; stories Story[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Tradition { id String @id @default(cuid()); name String; slug String; religionId String; religion Religion @relation(fields:[religionId],references:[id],onDelete:Cascade); works Work[]; stories Story[]; places Place[]; @@unique([religionId,slug]) }
model Source { id String @id @default(cuid()); externalId String? @unique; name String; url String; license String?; rightsStatus RightsStatus @default(UNKNOWN); commercialUse Boolean @default(false); attribution String?; works Work[]; passages Passage[]; stories Story[]; places Place[]; contentItems ContentItem[]; audioAssets AudioAsset[]; createdAt DateTime @default(now()) }
model Work { id String @id @default(cuid()); externalId String? @unique; title String; slug String @unique; language String; edition String?; translator String?; rightsStatus RightsStatus @default(UNKNOWN); religionId String; religion Religion @relation(fields:[religionId],references:[id],onDelete:Cascade); traditionId String?; tradition Tradition? @relation(fields:[traditionId],references:[id],onDelete:SetNull); sourceId String?; source Source? @relation(fields:[sourceId],references:[id],onDelete:SetNull); passages Passage[]; progress WorkProgress[]; bookmarks Bookmark[]; audioAssets AudioAsset[]; contentItems ContentItem[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Passage { id String @id @default(cuid()); reference String; sequence Int; text String; language String; workId String; work Work @relation(fields:[workId],references:[id],onDelete:Cascade); sourceId String?; source Source? @relation(fields:[sourceId],references:[id],onDelete:SetNull); bookmarks Bookmark[]; audioSegments AudioSegment[]; contentItems ContentItem[]; @@unique([workId,reference]); @@index([workId,sequence]) }
model Story { id String @id @default(cuid()); title String; slug String @unique; summary String?; body String; audience Audience; ageMin Int?; ageMax Int?; intensity StoryIntensity @default(GENTLE); narrationProfile NarrationProfile @default(DEFAULT); contentWarnings String[]; status StoryStatus @default(DRAFT); religionId String?; religion Religion? @relation(fields:[religionId],references:[id],onDelete:SetNull); traditionId String?; tradition Tradition? @relation(fields:[traditionId],references:[id],onDelete:SetNull); scenes StoryScene[]; progress StoryProgress[]; bookmarks Bookmark[]; audioAssets AudioAsset[]; places PlaceOnStory[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Place { id String @id @default(cuid()); name String; slug String @unique; country String; region String?; placeType String; latitude Float?; longitude Float?; traditionalSignificance String?; historicalSignificance String?; archaeologicalEvidence String?; uncertaintyNotes String?; religionId String?; traditionId String?; tradition Tradition? @relation(fields:[traditionId],references:[id],onDelete:SetNull); religion Religion? @relation(fields:[religionId],references:[id],onDelete:SetNull); sourceId String?; source Source? @relation(fields:[sourceId],references:[id],onDelete:SetNull); contentItems PlaceOnContent[]; stories PlaceOnStory[]; audioAssets AudioAsset[]; @@index([country,region]) }
model ContentItem { id String @id @default(cuid()); title String; slug String @unique; type ContentType; audience Audience; ageMin Int?; ageMax Int?; language String; summary String?; body String; evidenceLens EvidenceLens?; rightsStatus RightsStatus @default(UNKNOWN); workId String?; work Work? @relation(fields:[workId],references:[id],onDelete:SetNull); passageId String?; passage Passage? @relation(fields:[passageId],references:[id],onDelete:SetNull); sourceId String?; source Source? @relation(fields:[sourceId],references:[id],onDelete:SetNull); places PlaceOnContent[]; audioAssets AudioAsset[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model PlaceOnContent { placeId String; contentId String; place Place @relation(fields:[placeId],references:[id],onDelete:Cascade); content ContentItem @relation(fields:[contentId],references:[id],onDelete:Cascade); @@id([placeId,contentId]) }
model PlaceOnStory { placeId String; storyId String; place Place @relation(fields:[placeId],references:[id],onDelete:Cascade); story Story @relation(fields:[storyId],references:[id],onDelete:Cascade); @@id([placeId,storyId]) }
model AudioAsset { id String @id @default(cuid()); title String?; language String; voiceId String?; narrationProfile String?; engine String?; storageKey String; durationMs Int?; rightsStatus RightsStatus @default(UNKNOWN); sourceId String?; source Source? @relation(fields:[sourceId],references:[id],onDelete:SetNull); workId String?; work Work? @relation(fields:[workId],references:[id],onDelete:SetNull); contentId String?; content ContentItem? @relation(fields:[contentId],references:[id],onDelete:SetNull); storyId String?; story Story? @relation(fields:[storyId],references:[id],onDelete:SetNull); placeId String?; place Place? @relation(fields:[placeId],references:[id],onDelete:SetNull); segments AudioSegment[]; jobs AudioJob[]; createdAt DateTime @default(now()); @@index([language,narrationProfile]) }
model AudioSegment { id String @id @default(cuid()); sequence Int; startMs Int; endMs Int; storageKey String?; transcript String?; passageId String?; passage Passage? @relation(fields:[passageId],references:[id],onDelete:SetNull); storySceneId String?; storyScene StoryScene? @relation(fields:[storySceneId],references:[id],onDelete:SetNull); audioAssetId String; audioAsset AudioAsset @relation(fields:[audioAssetId],references:[id],onDelete:Cascade); @@unique([audioAssetId,sequence]); @@index([storySceneId]) }
model AudioJob { id String @id @default(cuid()); status AudioJobStatus @default(QUEUED); attempts Int @default(0); maxAttempts Int @default(3); errorMessage String?; nextRunAt DateTime @default(now()); lockedAt DateTime?; audioAssetId String; audioAsset AudioAsset @relation(fields:[audioAssetId],references:[id],onDelete:Cascade); segmentSequence Int?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([status,nextRunAt]); @@index([audioAssetId,status]) }
model StoryScene { id String @id @default(cuid()); sequence Int; title String?; text String; mood String?; narrationProfile NarrationProfile?; storyId String; story Story @relation(fields:[storyId],references:[id],onDelete:Cascade); audioSegments AudioSegment[]; @@unique([storyId,sequence]) }
model AICitation { id String @id @default(cuid()); lens EvidenceLens; sourceName String; sourceUrl String?; quote String?; note String?; createdAt DateTime @default(now()) }
model WorkProgress { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); workId String; work Work @relation(fields:[workId],references:[id],onDelete:Cascade); currentSequence Int @default(1); progressPercent Int @default(0); positionMs Int @default(0); completedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([userId,workId]); @@index([userId,updatedAt]) }
model StoryProgress { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); storyId String; story Story @relation(fields:[storyId],references:[id],onDelete:Cascade); currentScene Int @default(1); progressPercent Int @default(0); positionMs Int @default(0); completedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@unique([userId,storyId]); @@index([userId,updatedAt]) }
model Bookmark { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); workId String?; work Work? @relation(fields:[workId],references:[id],onDelete:Cascade); passageId String?; passage Passage? @relation(fields:[passageId],references:[id],onDelete:Cascade); storyId String?; story Story? @relation(fields:[storyId],references:[id],onDelete:Cascade); note String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([userId,createdAt]); @@index([workId]); @@index([passageId]); @@index([storyId]) }

# Self-hosted PostgreSQL on the KVM / Coolify
POSTGRES_DB="religion_audio"
POSTGRES_USER="religion_audio"
POSTGRES_PASSWORD="replace-with-a-long-url-safe-password"

DATABASE_URL="postgresql://religion_audio:replace-with-a-long-url-safe-password@db:5432/religion_audio"

# Audio storage: the server's disk until the four R2 values below are set, then Cloudflare R2 automatically.
AUDIO_STORAGE_DIR="/data/generated-audio"
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Optional: the bucket's public URL (r2.dev or a custom domain) so audio streams straight from Cloudflare
R2_PUBLIC_BASE_URL=""

TTS_SERVICE_URL="http://tts:8010"
KOKORO_VOICE_EN="af_heart"
KOKORO_VOICE_HI="hf_alpha"
PIPER_MODEL_DIR="/models"

# Ask AI + title fallback: OpenRouter (free models). Gemini on Vertex (below) is tried first when configured.
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="openrouter/free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free"
OPENROUTER_SITE_URL=""

AUTH_SECRET="replace-with-a-long-random-secret"

# Admin account, checked on every start: created if missing, and its password kept equal to ADMIN_PASSWORD
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Gemini on Vertex AI (cover + title generation). Paste the whole service-account JSON (or its base64).
GOOGLE_VERTEX_CREDENTIALS_JSON=""
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
